GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash
BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic
# Public HTTPS origin used by Binance to fetch the OAuth client metadata document.
ROKAI_PUBLIC_URL=https://your-public-rokai-host.example
# Optional overrides when the metadata document or callback are hosted separately.
BINANCE_OAUTH_CLIENT_METADATA_URL=https://your-public-rokai-host.example/api/binance/client-metadata.json
BINANCE_OAUTH_REDIRECT_URL=https://your-public-rokai-host.example/api/binance/auth/callback
